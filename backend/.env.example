NODE_ENV=development
PORT=4000

# Leave empty in development to use an in-memory MongoDB with demo data.
# Docker: mongodb://localhost:27017/ahcl360   Atlas: mongodb+srv://...
MONGO_URI=

# Comma separated list of allowed origins for the admin panel ("*" = any)
CORS_ORIGINS=*

# REQUIRED in production - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Sessions idle longer than this are logged out
IDLE_TIMEOUT_MINUTES=30

# 64 hex chars (32 bytes). Used for AES-256-GCM encryption of PAN/Aadhaar/bank details and uploaded files.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Dev only: OTP is returned in the API response. Set to false to test real SMS.
OTP_EXPOSE=true
# HTTP endpoint of your SMS provider (receives {to, message})
SMS_WEBHOOK_URL=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Travel reimbursement rates (INR per km)
RATE_PER_KM_BIKE=3.5
RATE_PER_KM_CAR=9
RATE_PER_KM_PUBLIC=2

COMPANY_NAME=AHCL
COMPANY_GSTIN=21AAACA0000A1Z5
COMPANY_ADDRESS=Registered Office, Bhubaneswar, Odisha
COMPANY_STATE_CODE=21
SUPPORT_PHONE=+91-0000000000
SUPPORT_EMAIL=support@example.com

# Path to Firebase service account JSON to enable FCM push (also: npm i firebase-admin)
FIREBASE_SERVICE_ACCOUNT=
