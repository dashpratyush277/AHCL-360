NODE_ENV=development
PORT=4000

# Leave empty in development to use an in-memory MongoDB with demo data.
# Docker: mongodb://localhost:27017/ahcl360   Atlas: mongodb+srv://...
MONGO_URI=

# Comma separated list of allowed origins for the admin panel ("*" = any)
CORS_ORIGINS=*

# REQUIRED in production - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Sessions idle longer than this are logged out
IDLE_TIMEOUT_MINUTES=30

# 64 hex chars (32 bytes). Used for AES-256-GCM encryption of PAN/Aadhaar/bank details and uploaded files.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
# Dev only: OTP is also shown on the login screen. Always false in production.
OTP_EXPOSE=true

# ---------------- SMS OTP ----------------
# fast2sms | msg91 | twilio | webhook | console (console = print OTP in server log; dev only)
# Indian SMS needs a DLT-registered sender ID + approved template, for example:
#   "{#var#} is your AHCL 360 login OTP. Valid for 5 minutes. Do not share it. - AHCL"
SMS_PROVIDER=console
SMS_COUNTRY_CODE=91
# Fast2SMS (DLT route) – verified API: https://docs.fast2sms.com/reference/dlt-sms-single
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=
# MSG91 (Flow API) – confirm the template variable name in your MSG91 account before go-live
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Any other gateway: POST {to, message, otp} to this URL
SMS_WEBHOOK_URL=

# ---------------- Email OTP (optional; for users who log in with email) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AHCL 360 <no-reply@yourdomain.in>

# Load demo accounts into an EMPTY database at startup (demo/test servers only)
SEED_DEMO=false
# Serve the built admin panel from this folder (set automatically in the Docker image)
ADMIN_DIST_DIR=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Travel reimbursement rates (INR per km)
RATE_PER_KM_BIKE=3.5
RATE_PER_KM_CAR=9
RATE_PER_KM_PUBLIC=2

COMPANY_NAME=AHCL
COMPANY_GSTIN=21AAACA0000A1Z5
COMPANY_ADDRESS=Registered Office, Bhubaneswar, Odisha
COMPANY_STATE_CODE=21
SUPPORT_PHONE=+91-0000000000
SUPPORT_EMAIL=support@example.com

# ---------------- Push notifications (Firebase Cloud Messaging) ----------------
# Firebase console → Project settings → Service accounts → Generate new private key.
# Either the path to that JSON file, or the whole file base64-encoded (handy on hosting dashboards):
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_BASE64=
