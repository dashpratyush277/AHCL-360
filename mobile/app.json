{
  "expo": {
    "name": "AHCL 360",
    "slug": "ahcl-360",
    "scheme": "ahcl360",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahcl.app360",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AHCL 360 uses your location to validate attendance and client visits.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "AHCL 360 tracks your route during office hours to calculate travel distance and expenses.",
        "NSCameraUsageDescription": "Take photos of bills and KYC documents.",
        "NSPhotoLibraryUsageDescription": "Attach bills and KYC documents from your photos."
      }
    },
    "android": {
      "package": "com.ahcl.app360",
      "adaptiveIcon": {
        "backgroundColor": "#E3F2EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AHCL 360 tracks your route during office hours to calculate travel distance and expenses.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F6E4F",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach bills and KYC documents from your photos.",
          "cameraPermission": "Take photos of bills and KYC documents."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
